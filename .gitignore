# ==============================================================================
# Python & Environment (uv)
# ==============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
**__pycache__/
*.py[codz]
*$py.class
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Virtual Environments
.venv
venv/
.venv/
.env
env/

# UV Lockfile
#Ignore if needed for collaboration, but can cause issues with platform-specific dependencies
# uv.lock 

# Jupyter Notebook
.ipynb_checkpoints
**/.ipynb_checkpoints/

# ==============================================================================
# Security & Credentials 
# ==============================================================================
# Never commit GCP Service Account keys or local environment variables
**google_credentials.json
*.json
*.key
**/credentials/*
**/secrets.**

# GCP SDK local credentials
.config/gcloud/
**/.config/gcloud/
.config/
.ssh/

# ==============================================================================
# Data & Data Lake 
# ==============================================================================
# Never commit data files to GitHub
*.parquet
*.csv
**/data/*
**/tmp/*
**/temp/*

# ==============================================================================
# Logs
# ==============================================================================
logs/runs
logs/*.log
**logs/

# ==============================================================================
